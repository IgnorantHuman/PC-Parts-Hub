@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<section class="auth-page">

    <div class="container">

        <div class="auth-card">

            <div class="row g-0">

                <!-- Left information panel -->
                <div class="col-lg-5 auth-side-panel register-side-panel">

                    <a asp-area=""
                       asp-page="/Index"
                       class="auth-logo">

                        <i class="bi bi-cpu-fill"></i>
                        PC Parts Hub

                    </a>

                    <div class="auth-side-content">

                        <span class="auth-badge">

                            <i class="bi bi-person-plus me-1"></i>
                            Join our marketplace

                        </span>

                        <h1>
                            Start building your marketplace account
                        </h1>

                        <p>
                            Register to browse PC components, purchase
                            products or begin selling your own components.
                        </p>

                        <div class="auth-role-preview">

                            <div class="role-preview-icon">
                                <i class="bi bi-cart3"></i>
                            </div>

                            <div>
                                <strong>Buyer</strong>

                                <span>
                                    Browse, add to cart and place orders
                                </span>
                            </div>

                        </div>

                        <div class="auth-role-preview">

                            <div class="role-preview-icon">
                                <i class="bi bi-shop"></i>
                            </div>

                            <div>
                                <strong>Seller</strong>

                                <span>
                                    Create and manage product listings
                                </span>
                            </div>

                        </div>

                    </div>

                    <div class="auth-decoration">
                        <i class="bi bi-pc-display-horizontal"></i>
                    </div>

                </div>

                <!-- Right registration form -->
                <div class="col-lg-7 auth-form-panel">

                    <div class="auth-form-header">

                        <span class="auth-form-icon">
                            <i class="bi bi-person-plus"></i>
                        </span>

                        <div>
                            <h2>Create your account</h2>

                            <p>
                                Complete the information below to register.
                            </p>
                        </div>

                    </div>

                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="form-floating mb-3">

                            <input asp-for="Input.FullName"
                                   class="form-control"
                                   autocomplete="name"
                                   placeholder="Full name" />

                            <label asp-for="Input.FullName">

                                <i class="bi bi-person me-1"></i>
                                Full name

                            </label>

                            <span asp-validation-for="Input.FullName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="account-type-section mb-4">

                            <label class="form-label fw-semibold">

                                <i class="bi bi-person-badge me-1"></i>
                                Select account type

                            </label>

                            <div class="row g-3">

                                <!-- Buyer -->
                                <div class="col-sm-6">

                                    <input asp-for="Input.AccountType"
                                           type="radio"
                                           value="Buyer"
                                           id="buyerAccount"
                                           class="btn-check account-type-input"
                                           autocomplete="off" />

                                    <label for="buyerAccount"
                                           class="account-type-card">

                                        <span class="account-type-icon buyer-icon">

                                            <i class="bi bi-cart3"></i>

                                        </span>

                                        <span class="account-type-content">

                                            <strong>Buyer</strong>

                                            <small>
                                                Browse products, add to cart
                                                and place orders
                                            </small>

                                        </span>

                                        <span class="account-selected-icon">

                                            <i class="bi bi-check-circle-fill"></i>

                                        </span>

                                    </label>
                                </div>

                                <!-- Seller -->
                                <div class="col-sm-6">

                                    <input asp-for="Input.AccountType"
                                           type="radio"
                                           value="Seller"
                                           id="sellerAccount"
                                           class="btn-check account-type-input"
                                           autocomplete="off" />

                                    <label for="sellerAccount"
                                           class="account-type-card">

                                        <span class="account-type-icon seller-icon">

                                            <i class="bi bi-shop"></i>

                                        </span>

                                        <span class="account-type-content">

                                            <strong>Seller</strong>

                                            <small>
                                                Create and manage your
                                                component listings
                                            </small>

                                        </span>

                                        <span class="account-selected-icon">

                                            <i class="bi bi-check-circle-fill"></i>

                                        </span>

                                    </label>
                                </div>
                            </div>

                            <span asp-validation-for="Input.AccountType"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-floating mb-3">

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="name@example.com" />

                            <label asp-for="Input.Email">

                                <i class="bi bi-envelope me-1"></i>
                                Email address

                            </label>

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="input-group password-group mb-2">

                            <div class="form-floating">

                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Password" />

                                <label asp-for="Input.Password">

                                    <i class="bi bi-lock me-1"></i>
                                    Password

                                </label>

                            </div>

                            <button type="button"
                                    class="btn password-toggle"
                                    data-target="Input_Password"
                                    title="Show password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger d-block mb-3">
                        </span>

                        <div class="input-group password-group mb-2">

                            <div class="form-floating">

                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Confirm password" />

                                <label asp-for="Input.ConfirmPassword">

                                    <i class="bi bi-lock-fill me-1"></i>
                                    Confirm password

                                </label>

                            </div>

                            <button type="button"
                                    class="btn password-toggle"
                                    data-target="Input_ConfirmPassword"
                                    title="Show password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger d-block mb-3">
                        </span>

                        <div class="password-requirements">

                            <p>
                                <i class="bi bi-info-circle me-1"></i>
                                Your password should contain:
                            </p>

                            <div class="password-rules">

                                <span id="lengthRule">
                                    <i class="bi bi-circle"></i>
                                    At least 8 characters
                                </span>

                                <span id="upperRule">
                                    <i class="bi bi-circle"></i>
                                    One uppercase letter
                                </span>

                                <span id="lowerRule">
                                    <i class="bi bi-circle"></i>
                                    One lowercase letter
                                </span>

                                <span id="numberRule">
                                    <i class="bi bi-circle"></i>
                                    One number
                                </span>

                            </div>
                        </div>

                        <div class="form-check my-4">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="termsCheckbox"
                                   required />

                            <label class="form-check-label"
                                   for="termsCheckbox">

                                I agree to the

                                <a asp-area=""
                                   asp-page="/Privacy"
                                   class="auth-link">

                                    Privacy Policy

                                </a>

                            </label>

                        </div>

                        <button id="registerSubmit"
                                type="submit"
                                class="btn auth-submit-button w-100">

                            <span class="button-text">

                                <i class="bi bi-person-check me-2"></i>
                                Create Account

                            </span>

                            <span class="button-loading d-none">

                                <span class="spinner-border
                                    spinner-border-sm me-2">
                                </span>

                                Creating account...

                            </span>

                        </button>

                        <div class="auth-divider">

                            <span>
                                Already have an account?
                            </span>

                        </div>

                        <a asp-page="./Login"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           class="btn auth-secondary-button w-100">

                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Login to existing account

                        </a>

                    </form>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
