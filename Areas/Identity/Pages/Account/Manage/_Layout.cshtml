@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<section class="account-manage-section py-5">
    <div class="container">
        <div class="account-heading mb-4">
            <span class="account-eyebrow"><i class="bi bi-shield-check me-1"></i>ACCOUNT CENTRE</span>
            <h1 class="fw-bold mb-1">Manage your account</h1>
            <p class="text-muted mb-0">Update your profile, login details and security preferences.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-3">
                <aside class="account-sidebar">
                    <div class="account-sidebar-title"><i class="bi bi-person-circle"></i><span>Account settings</span></div>
                    <partial name="_ManageNav" />
                </aside>
            </div>
            <div class="col-lg-9">
                <div class="account-content-card">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
