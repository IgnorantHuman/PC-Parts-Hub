@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<section class="auth-page">

    <div class="container">

        <div class="auth-card">

            <div class="row g-0">

                <!-- Left information panel -->
                <div class="col-lg-5 auth-side-panel">

                    <a asp-area=""
                       asp-page="/Index"
                       class="auth-logo">

                        <i class="bi bi-cpu-fill"></i>
                        PC Parts Hub

                    </a>

                    <div class="auth-side-content">

                        <span class="auth-badge">

                            <i class="bi bi-shield-check me-1"></i>
                            Secure marketplace access

                        </span>

                        <h1>
                            Welcome back to PC Parts Hub
                        </h1>

                        <p>
                            Login to browse components, manage product
                            listings and access your marketplace account.
                        </p>

                        <div class="auth-benefit">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Browse Admin-approved PC components
                            </span>

                        </div>

                        <div class="auth-benefit">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Manage your shopping cart and orders
                            </span>

                        </div>

                        <div class="auth-benefit">

                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Access Buyer, Seller or Admin functions
                            </span>

                        </div>

                    </div>

                    <div class="auth-decoration">
                        <i class="bi bi-motherboard"></i>
                    </div>

                </div>

                <!-- Right login form -->
                <div class="col-lg-7 auth-form-panel">

                    <div class="auth-form-header">

                        <span class="auth-form-icon">
                            <i class="bi bi-person-lock"></i>
                        </span>

                        <div>
                            <h2>Login to your account</h2>

                            <p>
                                Enter your registered email and password.
                            </p>
                        </div>

                    </div>

                    <form id="account"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="form-floating mb-3">

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="name@example.com" />

                            <label asp-for="Input.Email">

                                <i class="bi bi-envelope me-1"></i>
                                Email address

                            </label>

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="input-group password-group mb-2">

                            <div class="form-floating">

                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       placeholder="Password" />

                                <label asp-for="Input.Password">

                                    <i class="bi bi-lock me-1"></i>
                                    Password

                                </label>

                            </div>

                            <button type="button"
                                    class="btn password-toggle"
                                    data-target="Input_Password"
                                    title="Show password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger d-block mb-3">
                        </span>

                        <div class="d-flex flex-wrap
                            justify-content-between
                            align-items-center
                            gap-2 mb-4">

                            <div class="form-check">

                                <input asp-for="Input.RememberMe"
                                       class="form-check-input" />

                                <label asp-for="Input.RememberMe"
                                       class="form-check-label">

                                    Remember me

                                </label>

                            </div>

                            <a asp-page="./ForgotPassword"
                               class="auth-link">

                                Forgot password?

                            </a>

                        </div>

                        <button id="login-submit"
                                type="submit"
                                class="btn auth-submit-button w-100">

                            <span class="button-text">

                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Login

                            </span>

                            <span class="button-loading d-none">

                                <span class="spinner-border
                                    spinner-border-sm me-2">
                                </span>

                                Logging in...

                            </span>

                        </button>

                        <div class="auth-divider">

                            <span>
                                New to PC Parts Hub?
                            </span>

                        </div>

                        <a asp-page="./Register"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           class="btn auth-secondary-button w-100">

                            <i class="bi bi-person-plus me-2"></i>
                            Create a new account

                        </a>

                    </form>

                    <div class="auth-security-message">

                        <i class="bi bi-shield-lock-fill"></i>

                        <span>
                            Your password is protected by ASP.NET Core Identity.
                        </span>

                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}