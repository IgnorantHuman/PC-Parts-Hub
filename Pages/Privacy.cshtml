@page
@model PrivacyModel

@{
    ViewData["Title"] = "Privacy";
}

<section class="py-5">
    <div class="container">

        <div class="card border-0 shadow-sm mx-auto"
             style="max-width: 850px; border-radius: 16px;">

            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-5">
                    <div class="category-icon mx-auto">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <h1 class="fw-bold">Privacy Policy</h1>

                    <p class="text-muted">
                        Learn how PC Parts Hub manages and protects user information.
                    </p>
                </div>

                <h2 class="h5 fw-bold">Information We Collect</h2>

                <p class="text-muted">
                    PC Parts Hub collects information needed to create user
                    accounts, manage product listings and process simulated orders.
                </p>

                <hr />

                <h2 class="h5 fw-bold">How Information Is Used</h2>

                <p class="text-muted">
                    User information is used only for marketplace functions,
                    including authentication, product management and order records.
                </p>

                <hr />

                <h2 class="h5 fw-bold">Account Security</h2>

                <p class="text-muted">
                    Users are responsible for protecting their login information
                    and should not share their passwords with other people.
                </p>

                <hr />

                <h2 class="h5 fw-bold">Assignment Disclaimer</h2>

                <p class="text-muted mb-0">
                    This website is developed for academic purposes. Its checkout
                    process is simulated and does not collect real payments.
                </p>

            </div>
        </div>
    </div>
</section>