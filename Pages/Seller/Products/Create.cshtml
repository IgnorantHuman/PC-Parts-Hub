@page
@model PCShop.Pages.Seller.Products.CreateModel

@{
    ViewData["Title"] = "Create Product";
}

<section class="seller-area py-5">
    <div class="container seller-form-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="text-primary fw-semibold">NEW LISTING</span>
                <h1 class="fw-bold mb-1">Create Product</h1>
                <p class="text-muted mb-0">The listing will be Pending until an Admin reviews it.</p>
            </div>
            <a asp-page="./Index" class="btn btn-outline-primary">Back</a>
        </div>

        <div class="card seller-card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-4">
                        <div class="col-md-8">
                            <label asp-for="Product.Name" class="form-label fw-semibold"></label>
                            <input asp-for="Product.Name" class="form-control" placeholder="Example: ASUS Dual RTX 4060 OC" />
                            <span asp-validation-for="Product.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Product.Brand" class="form-label fw-semibold"></label>
                            <input asp-for="Product.Brand" class="form-control" placeholder="Example: ASUS" />
                            <span asp-validation-for="Product.Brand" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Product.Category" class="form-label fw-semibold"></label>
                            <select asp-for="Product.Category" asp-items="Model.CategoryOptions" class="form-select">
                                <option value="">-- Select category --</option>
                            </select>
                            <span asp-validation-for="Product.Category" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Product.Condition" class="form-label fw-semibold"></label>
                            <select asp-for="Product.Condition" asp-items="Model.ConditionOptions" class="form-select"></select>
                            <span asp-validation-for="Product.Condition" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Product.Price" class="form-label fw-semibold"></label>
                            <div class="input-group"><span class="input-group-text">RM</span><input asp-for="Product.Price" class="form-control" /></div>
                            <span asp-validation-for="Product.Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Product.Stock" class="form-label fw-semibold"></label>
                            <input asp-for="Product.Stock" class="form-control" />
                            <span asp-validation-for="Product.Stock" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Product.Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Product.Description" class="form-control" rows="6"
                                      placeholder="Describe specifications, condition and included accessories..."></textarea>
                            <span asp-validation-for="Product.Description" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="UploadImages" class="form-label fw-semibold">Product Images</label>
                            <input asp-for="UploadImages" id="sellerImageInput" type="file" class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" multiple />
                            <div class="form-text">Upload 1–5 JPG, PNG or WEBP images. Maximum 5 MB each.</div>
                            <span asp-validation-for="UploadImages" class="text-danger d-block"></span>
                            <div id="sellerImagePreview" class="seller-image-preview mt-3"></div>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-send me-2"></i>Submit for Review
                    </button>
                    <a asp-page="./Index" class="btn btn-outline-secondary btn-lg ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js"></script>

    <script>
        tinymce.init({
        selector: "#Product_Description",
        license_key: "gpl",
        menubar: false,
        height: 280,
        plugins: "lists link",
        toolbar: "undo redo | bold italic underline | bullist numlist | link | removeformat",
        branding: false,
        promotion: false
        });

        document.querySelector("form")?.addEventListener(
        "submit",
        function () {
        tinymce.triggerSave();
        },
        true
        );

        document.getElementById("sellerImageInput")
        ?.addEventListener("change", function () {

        const preview =
        document.getElementById("sellerImagePreview");

        preview.innerHTML = "";

        [...this.files].slice(0, 5).forEach(file => {

        const image =
        document.createElement("img");

        image.src =
        URL.createObjectURL(file);

        image.alt =
        "Selected product image";

        image.onload = () =>
        URL.revokeObjectURL(image.src);

        preview.appendChild(image);
        });
        });
    </script>
}
