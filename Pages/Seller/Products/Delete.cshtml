@page "{id:int}"
@model PCShop.Pages.Seller.Products.DeleteModel

@{
    ViewData["Title"] = "Delete Product";
}

<section class="seller-area py-5">
    <div class="container seller-form-container">
        <div class="card seller-card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5 text-center">
                <div class="delete-warning-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <h1 class="fw-bold mt-3">Delete this listing?</h1>
                <p class="text-muted">This permanently removes the Pending product and its images.</p>

                @if (!string.IsNullOrWhiteSpace(Model.Product.ImagePath))
                {
                    <img src="@Model.Product.ImagePath" alt="@Model.Product.Name" class="seller-delete-image my-3" />
                }

                <h4>@Model.Product.Name</h4>
                <p class="mb-4">RM @Model.Product.Price.ToString("N2") · @Model.Product.Stock unit(s)</p>

                <form method="post" asp-route-id="@Model.Product.Id"
                      onsubmit="return confirm('This action cannot be undone. Continue?');">
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="bi bi-trash me-2"></i>Delete Permanently
                    </button>
                    <a asp-page="./Index" class="btn btn-outline-secondary btn-lg ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</section>
