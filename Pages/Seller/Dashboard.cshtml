@page
@model PCShop.Pages.Seller.DashboardModel
@using PCPartsHub.Models
@using System.Text.Json

@{
    ViewData["Title"] = "Seller Dashboard";
}

<section class="seller-area py-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <span class="text-primary fw-semibold">SELLER CENTRE</span>
                <h1 class="fw-bold mb-1">Seller Dashboard</h1>
                <p class="text-muted mb-0">Monitor your products, approval status and stock.</p>
            </div>

            <a asp-page="/Seller/Products/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Add Product
            </a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="seller-stat-card"><i class="bi bi-bag-check text-success"></i><small>Units Sold</small><strong>@Model.UnitsSold</strong></div></div>
            <div class="col-md-4"><div class="seller-stat-card"><i class="bi bi-cash-coin text-success"></i><small>Sales Revenue</small><strong>RM @Model.TotalRevenue.ToString("N2")</strong></div></div>
            <div class="col-md-4"><div class="seller-stat-card"><i class="bi bi-star-fill text-warning"></i><small>Customer Rating</small><strong>@Model.AverageRating.ToString("0.0") / 5 (@Model.ReviewCount)</strong></div></div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-xl">
                <div class="seller-stat-card">
                    <i class="bi bi-boxes text-primary"></i>
                    <small>Total Products</small>
                    <strong>@Model.TotalProducts</strong>
                </div>
            </div>
            <div class="col-6 col-xl">
                <div class="seller-stat-card">
                    <i class="bi bi-hourglass-split text-warning"></i>
                    <small>Pending</small>
                    <strong>@Model.PendingProducts</strong>
                </div>
            </div>
            <div class="col-6 col-xl">
                <div class="seller-stat-card">
                    <i class="bi bi-check-circle text-success"></i>
                    <small>Active</small>
                    <strong>@Model.ActiveProducts</strong>
                </div>
            </div>
            <div class="col-6 col-xl">
                <div class="seller-stat-card">
                    <i class="bi bi-x-circle text-danger"></i>
                    <small>Rejected</small>
                    <strong>@Model.RejectedProducts</strong>
                </div>
            </div>
            <div class="col-6 col-xl">
                <div class="seller-stat-card">
                    <i class="bi bi-exclamation-triangle text-danger"></i>
                    <small>Low Stock</small>
                    <strong>@Model.LowStockProducts</strong>
                </div>
            </div>
        </div>

        @if (Model.RecentRejectedProducts.Count > 0)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    <div class="flex-grow-1">
                        <h5 class="alert-heading fw-bold mb-2">Listings need your attention</h5>
                        @foreach (Product product in Model.RecentRejectedProducts)
                        {
                            <div class="border-top border-danger-subtle py-2">
                                <a asp-page="/Seller/Products/Details"
                                   asp-route-id="@product.Id"
                                   class="fw-semibold text-danger text-decoration-none">
                                    @product.Name
                                </a>
                                <div class="small">
                                    @(string.IsNullOrWhiteSpace(product.RejectionReason)
                                        ? "Open the listing to review the Admin feedback."
                                        : product.RejectionReason)
                                </div>
                            </div>
                        }
                        <a asp-page="/Seller/Products/Index"
                           asp-route-statusFilter="Rejected"
                           class="btn btn-sm btn-outline-danger mt-2">
                            View all rejected listings
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm seller-card h-100">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-1">Inventory Overview</h4>
                        <p class="text-muted">Current stock quantity for each listing.</p>

                        @if (Model.TotalProducts == 0)
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-bar-chart fs-1 text-muted"></i>
                                <p class="text-muted mt-3 mb-0">Add your first product to display the chart.</p>
                            </div>
                        }
                        else
                        {
                            <div class="seller-chart-wrap">
                                <canvas id="inventoryChart"></canvas>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm seller-card h-100">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3">Quick Actions</h4>
                        <div class="d-grid gap-3">
                            <a asp-page="/Seller/Products/Create" class="seller-action-link">
                                <i class="bi bi-plus-square"></i><span>Create a listing</span>
                            </a>
                            <a asp-page="/Seller/Products/Index" class="seller-action-link">
                                <i class="bi bi-card-list"></i><span>Manage listings</span>
                            </a>
                            <a asp-page="/Seller/Products/Index" asp-route-statusFilter="Rejected"
                               class="seller-action-link">
                                <i class="bi bi-chat-left-text"></i><span>View rejection feedback</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm seller-card mt-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-1">Sales by Product</h4>
                <p class="text-muted">Completed PayPal orders only.</p>
                @if (Model.UnitsSold == 0) { <p class="text-muted mb-0">No completed sales yet.</p> }
                else { <div class="seller-chart-wrap"><canvas id="salesChart"></canvas></div> }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @if (Model.TotalProducts > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
        <script>
            const sellerProductNames = @Html.Raw(JsonSerializer.Serialize(Model.ProductNames));
            const sellerProductStocks = @Html.Raw(JsonSerializer.Serialize(Model.ProductStocks));
            const salesProductNames = @Html.Raw(JsonSerializer.Serialize(Model.SalesProductNames));
            const salesQuantities = @Html.Raw(JsonSerializer.Serialize(Model.SalesQuantities));
            const inventoryCanvas = document.getElementById("inventoryChart");

            if (inventoryCanvas) {
                new Chart(inventoryCanvas, {
                    type: "bar",
                    data: {
                        labels: sellerProductNames,
                        datasets: [{
                            label: "Stock Quantity",
                            data: sellerProductStocks,
                            backgroundColor: "rgba(13, 110, 253, .72)",
                            borderColor: "#0d6efd",
                            borderWidth: 1,
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }

            const salesCanvas = document.getElementById("salesChart");
            if (salesCanvas) {
                new Chart(salesCanvas, {
                    type: "bar",
                    data: { labels: salesProductNames, datasets: [{ label: "Units Sold", data: salesQuantities, backgroundColor: "rgba(25, 135, 84, .72)", borderRadius: 8 }] },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
                });
            }
        </script>
    }
}
