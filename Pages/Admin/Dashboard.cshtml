@page
@model PCShop.Pages.Admin.DashboardModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-dashboard py-5">
    <div class="container">

        <div class="d-flex flex-wrap justify-content-between
            align-items-center gap-3 mb-4">

            <div>
                <span class="text-primary fw-semibold">
                    ADMINISTRATION
                </span>

                <h1 class="fw-bold mb-1">
                    Admin Dashboard
                </h1>

                <p class="text-muted mb-0">
                    Monitor and review PC component listings.
                </p>
            </div>

            <a asp-page="/Admin/Products/Index"
               class="btn btn-primary">

                <i class="bi bi-box-seam me-2"></i>
                Manage Listings
            </a>
        </div>

        <div class="row g-4 mb-5">

            <div class="col-sm-6 col-xl-3">
                <div class="admin-stat-card stat-total">
                    <div class="stat-icon">
                        <i class="bi bi-boxes"></i>
                    </div>

                    <div>
                        <p>Total Listings</p>
                        <h2>@Model.TotalProducts</h2>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="admin-stat-card stat-pending">
                    <div class="stat-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                    <div>
                        <p>Pending Review</p>
                        <h2>@Model.PendingProducts</h2>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="admin-stat-card stat-active">
                    <div class="stat-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div>
                        <p>Active Listings</p>
                        <h2>@Model.ActiveProducts</h2>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="admin-stat-card stat-rejected">
                    <div class="stat-icon">
                        <i class="bi bi-x-circle"></i>
                    </div>

                    <div>
                        <p>Rejected Listings</p>
                        <h2>@Model.RejectedProducts</h2>
                    </div>
                </div>
            </div>

        </div>

            <div class="row g-4 mb-5">

                <div class="col-lg-7">

                    <div class="card admin-chart-card border-0 shadow-sm h-100">

                        <div class="card-header bg-white border-0 p-4">

                            <div class="d-flex justify-content-between
                                align-items-center">

                                <div>
                                    <h4 class="fw-bold mb-1">
                                        Listing Status
                                    </h4>

                                    <p class="text-muted mb-0">
                                        Distribution of PC component listings
                                    </p>
                                </div>

                                <i class="bi bi-pie-chart fs-3 text-primary"></i>

                            </div>
                        </div>

                        <div class="card-body p-4">

                            @if (Model.TotalProducts == 0)
                            {
                                <div class="text-center py-5">

                                    <i class="bi bi-bar-chart fs-1 text-muted"></i>

                                    <h5 class="mt-3">
                                        No chart data yet
                                    </h5>

                                    <p class="text-muted">
                                        The chart will appear after Sellers add products.
                                    </p>

                                </div>
                            }
                            else
                            {
                                <div class="admin-chart-container">
                                    <canvas id="productStatusChart"></canvas>
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <div class="col-lg-5">

                    <div class="card admin-quick-card border-0 shadow-sm h-100">

                        <div class="card-header bg-white border-0 p-4">

                            <h4 class="fw-bold mb-1">
                                Quick Actions
                            </h4>

                            <p class="text-muted mb-0">
                                Common Administrator tasks
                            </p>

                        </div>

                        <div class="card-body p-4">

                            <div class="d-grid gap-3">

                                <a asp-page="/Admin/Products/Index"
                                   asp-route-statusFilter="Pending"
                                   class="admin-quick-action quick-pending">

                                    <div>
                                        <i class="bi bi-hourglass-split"></i>

                                        <span>
                                            Review Pending Listings
                                        </span>
                                    </div>

                                    <span class="badge bg-warning text-dark">
                                        @Model.PendingProducts
                                    </span>
                                </a>

                                <a asp-page="/Admin/Products/Index"
                                   asp-route-statusFilter="Active"
                                   class="admin-quick-action quick-active">

                                    <div>
                                        <i class="bi bi-check-circle"></i>

                                        <span>
                                            View Active Listings
                                        </span>
                                    </div>

                                    <span class="badge bg-success">
                                        @Model.ActiveProducts
                                    </span>
                                </a>

                                <a asp-page="/Admin/Products/Index"
                                   asp-route-statusFilter="Rejected"
                                   class="admin-quick-action quick-rejected">

                                    <div>
                                        <i class="bi bi-x-circle"></i>

                                        <span>
                                            View Rejected Listings
                                        </span>
                                    </div>

                                    <span class="badge bg-danger">
                                        @Model.RejectedProducts
                                    </span>
                                </a>

                                <a asp-page="/Admin/Actions"
                                   class="admin-quick-action quick-history">

                                    <div>
                                        <i class="bi bi-clock-history"></i>

                                        <span>
                                            View Action History
                                        </span>
                                    </div>

                                    <i class="bi bi-chevron-right"></i>
                                </a>

                            </div>
                        </div>
                    </div>
                </div>

            </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 p-4">
                <div class="d-flex justify-content-between
                    align-items-center">

                    <div>
                        <h4 class="fw-bold mb-1">
                            Recent Admin Actions
                        </h4>

                        <p class="text-muted mb-0">
                            Latest approvals and rejections
                        </p>
                    </div>

                    <i class="bi bi-clock-history fs-3 text-primary"></i>
                </div>
            </div>

            <div class="card-body p-0">

                @if (Model.RecentActions.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox fs-1 text-muted"></i>

                        <h5 class="mt-3">
                            No Admin actions yet
                        </h5>

                        <p class="text-muted">
                            Approval and rejection records will appear here.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Admin</th>
                                    <th>Action</th>
                                    <th>Reason</th>
                                    <th>Date</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var action in Model.RecentActions)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @(action.Product?.Name
                                                ?? "Unknown Product")
                                        </td>

                                        <td>
                                            @(action.Admin?.FullName
                                                ?? action.Admin?.Email
                                                ?? "Unknown Admin")
                                        </td>

                                        <td>
                                            @if (action.Action == "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @(string.IsNullOrEmpty(action.Reason)
                                                ? "-"
                                                : action.Reason)
                                        </td>

                                        <td>
                                            @action.ActionDate.ToString(
                                                "dd MMM yyyy, hh:mm tt")
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }

            </div>
        </div>

    </div>
</section>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js">
    </script>

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const chartElement =
                    document.getElementById(
                        "productStatusChart"
                    );

                if (!chartElement) {
                    return;
                }

                new Chart(
                    chartElement,
                    {
                        type: "doughnut",

                        data: {
                            labels: [
                                "Pending",
                                "Active",
                                "Rejected"
                            ],

                            datasets: [
                                {
                                    data: [
                                        @Model.PendingProducts,
                                        @Model.ActiveProducts,
                                        @Model.RejectedProducts
                                    ],

                                    backgroundColor: [
                                        "#f59e0b",
                                        "#22c55e",
                                        "#ef4444"
                                    ],

                                    borderColor: [
                                        "#ffffff",
                                        "#ffffff",
                                        "#ffffff"
                                    ],

                                    borderWidth: 4,

                                    hoverOffset: 12
                                }
                            ]
                        },

                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: "67%",

                            animation: {
                                duration: 1000,
                                easing: "easeOutQuart"
                            },

                            plugins: {
                                legend: {
                                    position: "bottom",

                                    labels: {
                                        usePointStyle: true,
                                        pointStyle: "circle",
                                        padding: 20,
                                        font: {
                                            size: 13
                                        }
                                    }
                                },

                                tooltip: {
                                    callbacks: {
                                        label: function (context) {

                                            const value =
                                                context.raw;

                                            const values =
                                                context.dataset.data;

                                            const total =
                                                values.reduce(
                                                    function (sum, number) {
                                                        return sum + number;
                                                    },
                                                    0
                                                );

                                            const percentage =
                                                total === 0
                                                    ? 0
                                                    : (
                                                        value /
                                                        total *
                                                        100
                                                    ).toFixed(1);

                                            return (
                                                context.label +
                                                ": " +
                                                value +
                                                " (" +
                                                percentage +
                                                "%)"
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                );
            }
        );
    </script>
}
