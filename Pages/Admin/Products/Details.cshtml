@page "{id:int}"
@model PCShop.Pages.Admin.Products.DetailsModel
@using PCPartsHub.Models

@{
    ViewData["Title"] = "Product Details";
}

<section class="admin-product-details py-5">

    <div class="container">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger
                alert-dismissible fade show">

                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        <div class="d-flex flex-wrap
            justify-content-between
            align-items-center gap-3 mb-4">

            <div>

                <span class="text-primary fw-semibold">
                    LISTING REVIEW
                </span>

                <h1 class="fw-bold mb-1">
                    Product Details
                </h1>

                <p class="text-muted mb-0">
                    Review information submitted by the Seller.
                </p>

            </div>

            <a asp-page="./Index"
               asp-route-statusFilter="All"
               class="btn btn-outline-primary">

                <i class="bi bi-arrow-left me-2"></i>
                Back to Listings

            </a>

        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-lg-5">

                <div class="row g-5">

                    <div class="col-lg-5">

                        @if (!string.IsNullOrWhiteSpace(
                            Model.Product.ImagePath))
                        {
                            <img src="@Model.Product.ImagePath"
                                 alt="@Model.Product.Name"
                                 class="admin-detail-image" />
                        }
                        else
                        {
                            <div class="admin-detail-placeholder">

                                <i class="bi bi-cpu"></i>

                                <span>
                                    No product image
                                </span>

                            </div>
                        }

                    </div>

                    <div class="col-lg-7">

                        <div class="d-flex
                            justify-content-between
                            align-items-start gap-3 mb-3">

                            <div>

                                <span class="text-primary fw-semibold">
                                    @Model.Product.Category
                                </span>

                                <h2 class="fw-bold mt-1">
                                    @Model.Product.Name
                                </h2>

                                <p class="text-muted">
                                    @Model.Product.Brand
                                </p>

                            </div>

                            <div>

                                @switch (Model.Product.Status)
                                {
                                    case ProductStatus.Pending:

                                        <span class="badge
                                            bg-warning
                                            text-dark
                                            rounded-pill p-2">

                                            <i class="bi
                                                bi-hourglass-split
                                                me-1">
                                            </i>

                                            Pending

                                        </span>

                                        break;

                                    case ProductStatus.Active:

                                        <span class="badge
                                            bg-success
                                            rounded-pill p-2">

                                            <i class="bi
                                                bi-check-circle
                                                me-1">
                                            </i>

                                            Active

                                        </span>

                                        break;

                                    case ProductStatus.Rejected:

                                        <span class="badge
                                            bg-danger
                                            rounded-pill p-2">

                                            <i class="bi
                                                bi-x-circle
                                                me-1">
                                            </i>

                                            Rejected

                                        </span>

                                        break;
                                }

                            </div>

                        </div>

                        <div class="product-detail-grid mb-4">

                            <div class="detail-item">
                                <span>Price</span>

                                @if (Model.Product.DiscountPercentage.HasValue)
                                {
                                    <div>
                                        <span class="text-decoration-line-through text-muted">
                                            RM @Model.Product.Price.ToString("N2")
                                        </span>

                                        <strong class="text-danger d-block">
                                            RM @Model.Product.PromotionPrice.ToString("N2")
                                        </strong>

                                        <span class="badge bg-danger">
                                            @Model.Product.DiscountPercentage.Value.ToString("0.##")% OFF
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <strong class="text-primary">
                                        RM @Model.Product.Price.ToString("N2")
                                    </strong>
                                }
                            </div>

                            <div class="detail-item">

                                <span>Stock</span>

                                <strong>
                                    @Model.Product.Stock unit(s)
                                </strong>

                            </div>

                            <div class="detail-item">

                                <span>Condition</span>

                                <strong>
                                    @Model.Product.Condition
                                </strong>

                            </div>

                            <div class="detail-item">

                                <span>Submitted</span>

                                <strong>
                                    @Model.Product.CreatedAt.ToString(
                                        "dd MMM yyyy")
                                </strong>

                            </div>

                        </div>

                        @if (Model.Product.DiscountPercentage.HasValue &&
     Model.Product.PromotionStart.HasValue &&
     Model.Product.PromotionEnd.HasValue)
                        {
                            <div class="alert alert-warning mb-4">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <i class="bi bi-percent fs-4"></i>

                                    <h5 class="fw-bold mb-0">
                                        Seller Promotion Review
                                    </h5>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <small class="text-muted d-block">
                                            Original price
                                        </small>

                                        <strong>
                                            RM @Model.Product.Price.ToString("N2")
                                        </strong>
                                    </div>

                                    <div class="col-md-3">
                                        <small class="text-muted d-block">
                                            Promotional price
                                        </small>

                                        <strong class="text-danger">
                                            RM @Model.Product.PromotionPrice.ToString("N2")
                                        </strong>
                                    </div>

                                    <div class="col-md-3">
                                        <small class="text-muted d-block">
                                            Discount
                                        </small>

                                        <strong>
                                            @Model.Product.DiscountPercentage.Value.ToString("0.##")%
                                        </strong>
                                    </div>

                                    <div class="col-md-3">
                                        <small class="text-muted d-block">
                                            Current status
                                        </small>

                                        @if (Model.Product.IsPromotionActive)
                                        {
                                            <span class="badge bg-success">
                                                Active now
                                            </span>
                                        }
                                        else if (Model.Product.PromotionStart.Value >
                                                 DateTime.UtcNow.AddHours(8))
                                        {
                                            <span class="badge bg-info text-dark">
                                                Scheduled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Ended
                                            </span>
                                        }
                                    </div>

                                    <div class="col-md-6">
                                        <small class="text-muted d-block">
                                            Start date
                                        </small>

                                        <strong>
                                            @Model.Product.PromotionStart.Value.ToString(
                                                "dd MMM yyyy, hh:mm tt")
                                        </strong>
                                    </div>

                                    <div class="col-md-6">
                                        <small class="text-muted d-block">
                                            End date
                                        </small>

                                        <strong>
                                            @Model.Product.PromotionEnd.Value.ToString(
                                                "dd MMM yyyy, hh:mm tt")
                                        </strong>
                                    </div>
                                </div>

                                <hr />

                                <p class="mb-0">
                                    Approving this listing will also approve the promotional price.
                                    Reject the listing if the discount or promotion dates are
                                    inappropriate.
                                </p>
                            </div>
                        }

                        <div class="mb-4">

                            <h5 class="fw-bold">
                                Description
                            </h5>

                            <div class="text-muted
                                product-description">

                                @Html.Raw(
                                    Model.Product.Description)

                            </div>

                        </div>

                        <div class="seller-information mb-4">

                            <div class="seller-avatar">

                                <i class="bi bi-person"></i>

                            </div>

                            <div>

                                <small class="text-muted">
                                    Submitted by
                                </small>

                                <div class="fw-semibold">

                                    @(Model.Product.Seller?.FullName
                                        ?? "Unknown Seller")

                                </div>

                                <small class="text-muted">
                                    @Model.Product.Seller?.Email
                                </small>

                            </div>

                        </div>

                        @if (Model.Product.Status ==
                            ProductStatus.Rejected)
                        {
                            <div class="alert alert-danger">

                                <h6 class="fw-bold">

                                    <i class="bi
                                        bi-chat-left-text
                                        me-1">
                                    </i>

                                    Rejection Reason

                                </h6>

                                <p class="mb-0">
                                    @Model.Product.RejectionReason
                                </p>

                            </div>
                        }

                        @if (Model.Product.ReviewedAt != null)
                        {
                            <p class="small text-muted">

                                Last reviewed on

                                @Model.Product.ReviewedAt.Value
                                .ToString(
                                "dd MMM yyyy, hh:mm tt")

                            </p>
                        }

                    </div>

                </div>

                @if (Model.Product.Status !=
                     ProductStatus.Rejected)
                {
                    <hr class="my-4" />

                    <div class="d-flex flex-wrap gap-3">

                        @if (Model.Product.Status ==
                            ProductStatus.Pending)
                        {
                            <form method="post"
                                  asp-page-handler="Approve"
                                  asp-route-id="@Model.Product.Id"
                                  onsubmit="
                                return confirm(
                                'Approve this listing?');">

                                <button type="submit"
                                        class="btn
                                    btn-success
                                    btn-lg">

                                    <i class="bi
                                        bi-check-circle
                                        me-2">
                                    </i>

                                    Approve Listing

                                </button>

                            </form>
                        }

                        <button type="button"
                                class="btn btn-danger btn-lg"
                                data-bs-toggle="collapse"
                                data-bs-target="#rejectForm">

                            <i class="bi bi-x-circle me-2"></i>

                            @(Model.Product.Status ==
                                ProductStatus.Active
                                ? "Reject Approved Listing"
                                : "Reject Listing")

                        </button>

                    </div>

                    <div id="rejectForm"
                         class="collapse
                        @(Model.ShowRejectForm
                            ? "show"
                            : "")">

                        <div class="reject-form-box mt-4">

                            <h5 class="fw-bold text-danger">

                                @(Model.Product.Status ==
                                    ProductStatus.Active
                                    ? "Reject approved listing"
                                    : "Reject this listing")

                            </h5>

                            @if (Model.Product.Status ==
                                ProductStatus.Active)
                            {
                                <div class="alert alert-warning">

                                    <i class="bi
                                        bi-exclamation-triangle
                                        me-2">
                                    </i>

                                    This product was approved previously.
                                    Rejecting it will remove it from the
                                    marketplace and buyers' carts.

                                </div>
                            }

                            <p class="text-muted">
                                Enter a reason to explain the problem
                                to the Seller.
                            </p>

                            <form method="post"
                                  asp-page-handler="Reject"
                                  asp-route-id="@Model.Product.Id">

                                <div class="mb-3">

                                    <label asp-for="RejectReason"
                                           class="form-label
                                        fw-semibold">
                                    </label>

                                    <textarea asp-for="RejectReason"
                                              class="form-control"
                                              rows="4"
                                              maxlength="500"
                                              placeholder="Example: The product information is inaccurate.">
                                    </textarea>

                                    <div class="form-text">
                                        Required: 1–500 characters
                                    </div>

                                    <span asp-validation-for="RejectReason"
                                          class="text-danger">
                                    </span>

                                </div>

                                <button type="submit"
                                        class="btn btn-danger">

                                    <i class="bi
                                        bi-x-circle
                                        me-2">
                                    </i>

                                    Confirm Rejection

                                </button>

                                <button type="button"
                                        class="btn
                                    btn-outline-secondary"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#rejectForm">

                                    Cancel

                                </button>

                            </form>

                        </div>

                    </div>
                }
                else
                {
                    <hr class="my-4" />

                    <div class="alert alert-secondary mb-0">

                        <i class="bi bi-info-circle me-2"></i>

                        This listing is already rejected.
                        The rejection reason is shown above.

                    </div>
                }

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}