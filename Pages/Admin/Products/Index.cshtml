@page
@model PCShop.Pages.Admin.Products.IndexModel
@using PCPartsHub.Models

@{
    ViewData["Title"] = "Manage Listings";
}

<section class="admin-products py-5">
    <div class="container">

        <div class="d-flex flex-wrap justify-content-between
            align-items-center gap-3 mb-4">

            <div>
                <span class="text-primary fw-semibold">
                    PRODUCT MANAGEMENT
                </span>

                <h1 class="fw-bold mb-1">
                    Manage Listings
                </h1>

                <p class="text-muted mb-0">
                    Review PC components submitted by Sellers.
                </p>
            </div>

            <a asp-page="/Admin/Dashboard"
               class="btn btn-outline-primary">

                <i class="bi bi-arrow-left me-2"></i>
                Dashboard
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">

                <form method="get"
                      class="row g-3 align-items-end">

                    <div class="col-lg-6">
                        <label asp-for="SearchTerm"
                               class="form-label fw-semibold">

                            Search listings
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input asp-for="SearchTerm"
                                   class="form-control"
                                   placeholder="Product, brand, category or seller..." />
                        </div>
                    </div>

                    <div class="col-md-5 col-lg-3">
                        <label asp-for="StatusFilter"
                               class="form-label fw-semibold">

                            Listing status
                        </label>

                        <select asp-for="StatusFilter"
                                class="form-select">

                            <option value="All">All listings</option>
                            <option value="Pending">Pending</option>
                            <option value="Active">Active</option>
                            <option value="Rejected">Rejected</option>

                        </select>
                    </div>

                    <div class="col-md-7 col-lg-3">
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">

                                <i class="bi bi-funnel me-1"></i>
                                Apply
                            </button>

                            <a asp-page="./Index"
                               asp-route-statusFilter="Pending"
                               class="btn btn-outline-secondary">

                                Clear
                            </a>

                        </div>
                    </div>

                </form>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between
            align-items-center gap-2 mb-3">

            <p class="mb-0 text-muted">
                Showing
                <strong>@Model.ProductList.Count</strong>
                listing(s)
            </p>

            <div class="d-flex flex-wrap gap-2">

                <a asp-page="./Index"
                   asp-route-statusFilter="Pending"
                   class="btn btn-sm btn-outline-warning">

                    Pending
                </a>

                <a asp-page="./Index"
                   asp-route-statusFilter="Active"
                   class="btn btn-sm btn-outline-success">

                    Active
                </a>

                <a asp-page="./Index"
                   asp-route-statusFilter="Rejected"
                   class="btn btn-sm btn-outline-danger">

                    Rejected
                </a>

                <a asp-page="./Index"
                   asp-route-statusFilter="All"
                   class="btn btn-sm btn-outline-secondary">

                    All
                </a>

            </div>
        </div>

        <div class="card border-0 shadow-sm overflow-hidden">

            @if (Model.ProductList.Count == 0)
            {
                <div class="text-center py-5 px-3">

                    <div class="admin-empty-icon">
                        <i class="bi bi-inbox"></i>
                    </div>

                    <h4 class="mt-3">
                        No listings found
                    </h4>

                    <p class="text-muted mb-3">
                        Try changing your search or status filter.
                    </p>

                    <a asp-page="./Index"
                       asp-route-statusFilter="Pending"
                       class="btn btn-primary">

                        Show Pending Listings
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Seller</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Submitted</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (Product product in Model.ProductList)
                            {
                                <tr>

                                    <td>
                                        <div class="d-flex align-items-center gap-3">

                                            @if (!string.IsNullOrWhiteSpace(
                                                    product.ImagePath))
                                            {
                                                <img src="@product.ImagePath"
                                                     alt="@product.Name"
                                                     class="admin-product-image" />
                                            }
                                            else
                                            {
                                                <div class="admin-product-placeholder">
                                                    <i class="bi bi-cpu"></i>
                                                </div>
                                            }

                                            <div>
                                                <div class="fw-semibold">
                                                    @product.Name
                                                </div>

                                                <small class="text-muted">
                                                    @product.Brand
                                                </small>
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        @product.Category
                                    </td>

                                    <td>
                                        <div>
                                            @(product.Seller?.FullName
                                                ?? "Unknown Seller")
                                        </div>

                                        <small class="text-muted">
                                            @product.Seller?.Email
                                        </small>
                                    </td>

                                    <td>
                                        @if (product.DiscountPercentage.HasValue &&
                                             product.PromotionStart.HasValue &&
                                             product.PromotionEnd.HasValue)
                                        {
                                            <div>
                                                <span class="text-decoration-line-through text-muted small">
                                                    RM @product.Price.ToString("N2")
                                                </span>
                                            </div>

                                            <div class="text-danger fw-bold">
                                                RM @product.PromotionPrice.ToString("N2")
                                            </div>

                                            <span class="badge bg-danger">
                                                @product.DiscountPercentage.Value.ToString("0.##")% OFF
                                            </span>

                                            @if (product.IsPromotionActive)
                                            {
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            }
                                            else if (product.PromotionStart.Value >
                                                     DateTime.UtcNow.AddHours(8))
                                            {
                                                <span class="badge bg-info text-dark">
                                                    Scheduled
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Ended
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">
                                                RM @product.Price.ToString("N2")
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @product.Stock
                                    </td>

                                    <td>
                                        @switch (product.Status)
                                        {
                                            case ProductStatus.Pending:
                                                <span class="badge rounded-pill
                                                    bg-warning text-dark">
                                                    <i class="bi bi-hourglass-split me-1"></i>
                                                    Pending
                                                </span>
                                                break;

                                            case ProductStatus.Active:
                                                <span class="badge rounded-pill
                                                    bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Active
                                                </span>
                                                break;

                                            case ProductStatus.Rejected:
                                                <span class="badge rounded-pill
                                                    bg-danger">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Rejected
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        @product.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-end">

                                        <a asp-page="./Details"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-eye me-1"></i>

                                            @(product.Status == ProductStatus.Pending
                                                ? "Review"
                                                : "View")
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</section>