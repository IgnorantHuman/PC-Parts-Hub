@page
@model PCShop.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="text-uppercase text-primary fw-semibold">
                Account updates
            </span>

            <h1 class="fw-bold mb-1">Notifications</h1>

            <p class="text-muted mb-0">
                View new products and marketplace updates.
            </p>
        </div>

        @if (Model.Notifications.Any(notification => !notification.IsRead))
        {
            <form method="post"
                  asp-page-handler="MarkAllAsRead">
                <button type="submit"
                        class="btn btn-outline-primary">
                    Mark all as read
                </button>
            </form>
        }
    </div>

    @if (!Model.Notifications.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center">
                <i class="bi bi-bell fs-1 text-muted"></i>

                <h4 class="mt-3">No notifications</h4>

                <p class="text-muted mb-0">
                    New marketplace updates will appear here.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach (var notification in Model.Notifications)
            {
                <div class="card border-0 shadow-sm
                    @(!notification.IsRead ? "border-start border-primary border-4" : "")">

                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="fw-bold mb-0">
                                        @notification.Title
                                    </h5>

                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge bg-primary">
                                            New
                                        </span>
                                    }
                                </div>

                                <p class="text-muted mt-2 mb-2">
                                    @notification.Message
                                </p>

                                <small class="text-muted">
                                    @notification.CreatedAt.ToString(
                                        "dd MMM yyyy, hh:mm tt")
                                </small>
                            </div>

                            @if (!notification.IsRead)
                            {
                                <form method="post"
                                      asp-page-handler="MarkAsRead">
                                    <input type="hidden"
                                           name="id"
                                           value="@notification.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-primary">
                                        View
                                    </button>
                                </form>
                            }
                            else if (!string.IsNullOrWhiteSpace(notification.Link))
                            {
                                <a href="@notification.Link"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>